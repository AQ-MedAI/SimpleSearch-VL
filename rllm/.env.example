# SimpleSearch-VL runtime environment (Bash syntax).
# Copy to rllm/.env with private permissions; never commit the filled file.
# All credentials and deployment-specific identifiers intentionally start empty.
# This file is sourced by run.sh; quote values, do not use <...> placeholders.

# Policy/agent model: API evaluation only, independent of the judge credentials.
# Set agent_model_api.base_url and model in your private YAML, not here.
AGENT_API_KEY=""

# Accuracy judge: required for the shipped RL/eval configs.
# Comma-separated lists; all three must have the same number of entries.
# BASE_URLS are API base URLs (usually ending in /v1), not /chat/completions URLs.
# For an explicitly unauthenticated judge use a non-secret value such as "unused"
# for that entry in JUDGE_API_KEYS (the current judge client requires a value).
JUDGE_MODELS=""
JUDGE_BASE_URLS=""
JUDGE_API_KEYS=""

# Visit summarization: the policy model is the default (no extra model service).
EXTRACT_MODEL="self"
# Set only when deliberately switching to an external summarization model.
# EXTRACT_URL should be the full URL ending in /v1/chat/completions.
# EXTRACT_KEY is forwarded as the Authorization header verbatim (include the scheme if required).
EXTRACT_URL=""
EXTRACT_KEY=""

# Serper: required for text_search and online image_search.
SERP_API_KEY=""
TEXT_SEARCH_URL="https://google.serper.dev/search"
# Region image_search uses the built-in https://google.serper.dev/lens endpoint.

# JINA Reader: optional key; blank uses unauthenticated requests, subject to limits.
# When set, the current reader client forwards this as Authorization verbatim;
# include the auth scheme (e.g. Bearer) required by your Reader service.
JINA_API_KEY=""
READER_URL="https://r.jina.ai"

# OSS: required when image_search is enabled (including online cache misses).
# Select your own region/bucket and scope credentials to the necessary operations.
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_ENDPOINT=""
OSS_BUCKET_NAME=""
OSS_PREFIX_NAME="simplesearch-vl"

# SQLite cache location is controlled by tools_config.cache_db_path in YAML.
CACHE_MAX_AGE_DAYS=360
